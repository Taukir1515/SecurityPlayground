    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let TaggedDevices =\nDeviceInfo\n| summarize arg_max(TimeGenerated, *) by DeviceId\n| where DeviceManualTags has \"swift\"\n| extend HostName = tolower(tostring(split(DeviceName, \".\")[0]))\n| project HostName;\nlet TaggedAlerts =\nSecurityAlert\n| mv-expand Entity=todynamic(Entities)\n| where tostring(Entity.Type) == \"host\"\n| extend HostName=tostring(Entity.HostName)\n| where HostName in (TaggedDevices)\n| distinct SystemAlertId;\nSecurityIncident\n| mv-expand AlertIds\n| extend SystemAlertId=tostring(AlertIds)\n| join kind=inner TaggedAlerts on SystemAlertId\n| summarize arg_max(TimeGenerated, Severity) by IncidentNumber\n| summarize Incidents=dcount(IncidentNumber) by Severity\n| order by Incidents desc",
        "size": 3,
        "title": "Incidents by Severity",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "piechart",
