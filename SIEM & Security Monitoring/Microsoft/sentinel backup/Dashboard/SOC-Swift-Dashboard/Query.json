        "version": "KqlItem/1.0",
        "query": "let TaggedDevices =\nDeviceInfo\n| summarize arg_max(TimeGenerated, *) by DeviceId\n| where DeviceManualTags has \"swift\"\n| extend HostName = tolower(tostring(split(DeviceName, \".\")[0]))\n| project HostName;\nlet TaggedAlerts =\nSecurityAlert\n| mv-expand Entity = todynamic(Entities)\n| where tostring(Entity.Type) == \"host\"\n| extend HostName = tostring(Entity.HostName)\n| where HostName in (TaggedDevices)\n| project SystemAlertId;\nSecurityIncident\n| mv-expand AlertIds\n| extend SystemAlertId = tostring(AlertIds)\n| join kind=inner TaggedAlerts on SystemAlertId\n| summarize arg_max(TimeGenerated, *) by IncidentNumber\n| extend SOC_Status = case(\n    Status == \"New\", \"Active\",\n    Status == \"Active\", \"In Progress\",\n    Status == \"Closed\", \"Resolved\",\n    Status\n)\n| mv-expand Label = todynamic(Labels)\n| extend LabelName = tostring(Label.labelName)\n| summarize\n    Severity = take_any(Severity),\n    Title = take_any(Title),\n    Alerts = take_any(tolong(parse_json(AdditionalData).alertsCount)),\n    Provider = take_any(ProviderName),\n    Created = take_any(CreatedTime),\n    Updated = take_any(LastModifiedTime),\n    Owner = take_any(iff(\n        isempty(tostring(parse_json(Owner).assignedTo)),\n        \"Unassigned\",\n        tostring(parse_json(Owner).assignedTo)\n    )),\n    Status = take_any(Status),\n    SOC_Status = take_any(SOC_Status),\n    ClosingComment = take_any(ClassificationComment),\n    WorkingEngineer = make_set(LabelName)\nby IncidentNumber\n| project\n    Severity,\n    IncidentNumber,\n    Title,\n    Alerts,\n    Provider,\n    Created,\n    Updated,\n    Owner,\n    WorkingEngineer = strcat_array(WorkingEngineer, \", \"),\n    Status=SOC_Status,\n    ClosingComment\n| order by Created desc",
