                        "name": "query - 2",
                        "content": {
                            "version": "KqlItem/1.0",
                            "query": "union withsource=[\"$TableName\"] *\r\n| where isnotempty(_BilledSize)\r\n| extend EventTime = todatetime(column_ifexists(\"TimeGenerated\", datetime(null)))\r\n| where EventTime >= ago(5m)\r\n| summarize LogCount = count()\r\n    by TableName=[\"$TableName\"]\r\n| extend EPS = round(todouble(LogCount) / 300.0, 2)\r\n| order by EPS desc\r\n| project TableName, LogCount, EPS",
